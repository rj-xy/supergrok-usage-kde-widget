{
  "name": "supergrok-usage-kde-widget",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "repository": {
    "url": "https://github.com/rj-xy/supergrok-usage-kde-widget"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "plasma:restart": "systemctl --user restart plasma-plasmashell",
    "build": "tsc && node scripts/emit-qml-logic.ts",
    "check": "tsc --noEmit",
    "test": "yarn run build && node --test tests/*.test.ts",
    "widget:init": "bash scripts/install.sh",
    "widget:copy": "bash scripts/install.sh --copy",
    "widget:panel": "bash scripts/install.sh --add-to-panel",
    "widget:remove": "bash scripts/uninstall.sh",
    "dist": "bash scripts/pack-plasmoid.sh",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
