#!/usr/bin/env bash
# Locate Node (plasmashell does not inherit nvm) and run the compiled CLI.
set -euo pipefail

NAME="supergrok-usage-kde-widget"

resolve_self_dir() {
  local source="${BASH_SOURCE[0]}"
  local n=0
  while [[ -L "$source" && n -lt 16 ]]; do
    local dir
    dir="$(cd "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
    n=$((n + 1))
  done
  cd "$(dirname "$source")" && pwd
}

find_root() {
  if [[ -n "${SUPERGROK_ROOT:-}" && -f "${SUPERGROK_ROOT}/dist/cli.js" ]]; then
    echo "$SUPERGROK_ROOT"
    return 0
  fi
  local dir
  dir="$(resolve_self_dir)"
  local n=0
  while [[ "$dir" != "/" && "$dir" != "." && -n "$dir" && n -lt 32 ]]; do
    if [[ -f "$dir/dist/cli.js" && -f "$dir/package.json" ]]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
    n=$((n + 1))
  done
  return 1
}

ROOT="$(find_root)" || {
  echo "$NAME: cannot find dist/cli.js. Run npm run install:widget from the repo." >&2
  exit 127
}
CLI="$ROOT/dist/cli.js"

resolve_node() {
  if [[ -n "${SUPERGROK_NODE:-}" && -x "${SUPERGROK_NODE}" ]]; then
    echo "$SUPERGROK_NODE"
    return 0
  fi
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi
  local cand
  if [[ -d "${HOME}/.nvm/versions/node" ]]; then
    cand="$(ls -1d "${HOME}/.nvm/versions/node"/v*/bin/node 2>/dev/null | sort -V | tail -1 || true)"
    if [[ -n "$cand" && -x "$cand" ]]; then
      echo "$cand"
      return 0
    fi
  fi
  for cand in /usr/local/bin/node /usr/bin/node; do
    if [[ -x "$cand" ]]; then
      echo "$cand"
      return 0
    fi
  done
  return 1
}

NODE="$(resolve_node)" || {
  echo "$NAME: node not found (install Node.js 20+)" >&2
  exit 127
}

exec "$NODE" "$CLI" "$@"
