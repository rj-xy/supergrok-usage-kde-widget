{
  "name": "supergrok-usage-kde-widget",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "repository": {
    "url": "https://github.com/rj-xy/supergrok-usage-kde-widget"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "plasma:restart": "systemctl --user restart plasma-plasmashell",
    "build": "tsc && node scripts/emit-qml-logic.ts",
    "test": "npm run build && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "install:widget": "bash scripts/install.sh",
    "install:copy": "bash scripts/install.sh --copy",
    "install:panel": "bash scripts/install.sh --add-to-panel",
    "uninstall": "bash scripts/uninstall.sh",
    "pack:plasmoid": "bash scripts/pack-plasmoid.sh",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
